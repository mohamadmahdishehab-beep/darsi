# Copy this file to .env.local and fill in the values.

# Firebase Console → Project settings (⚙️) → General → Your apps → Web app → SDK config
NEXT_PUBLIC_FIREBASE_API_KEY=AIza...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abc123

# Firebase Console → Project settings → Service accounts → Generate new private key (JSON file)
# SECRET: never put these in frontend code, never commit them
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# console.anthropic.com → API Keys (SECRET)
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5-5

# Your email: this account can open /admin
ADMIN_EMAIL=you@example.com


# Gmail that sends Darsi's emails (welcome, exam saved, daily plan, exam reminders)
# Google Account -> Security -> 2-Step Verification ON -> App passwords -> create one for "Darsi"
GMAIL_USER=yourdarsi@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
# Your live site address, used for the buttons inside emails
SITE_URL=https://your-site.netlify.app

# Optional: use Ollama instead of Claude (choose it in Control panel → AI agent)
OLLAMA_API_KEY=
OLLAMA_URL=https://ollama.com/v1
OLLAMA_MODEL=gpt-oss:120b
